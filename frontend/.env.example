# Copy to .env.local and fill in. .env.local is gitignored.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: call the API directly instead of through the /api forward
# (vercel.json / vite.config.ts). Leave unset normally.
# VITE_API_DIRECT_URL=

# Matterport Showcase SDK key (the same value as MATTERPORT_SDK_KEY in backend/.env). It only works on
# domains in its allow list, so add localhost:5173 and the deployed site. Without it the fly-through
# falls back to a basic embed that jumps between stops. Vercel needs it too (Vite bakes it in at build).
VITE_MATTERPORT_SDK_KEY=
