{
  "name": "photon-sidecar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The only service that talks to Photon: posts the crew's route and carries their replies to the backend.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@photon-ai/api": "^0.6.0",
    "standardwebhooks": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
